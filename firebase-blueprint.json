{
  "entities": {
    "Song": {
      "title": "Song",
      "description": "Sheet music, technique chart, image, or audio metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "key": { "type": "string" },
        "originalKey": { "type": "string" },
        "tempo": { "type": "number" },
        "timeSignature": { "type": "string" },
        "genre": { "type": "string" },
        "section": { "type": "string" },
        "type": { "type": "string" },
        "fileUrl": { "type": "string" },
        "favorite": { "type": "boolean" },
        "dateAdded": { "type": "number" },
        "dateModified": { "type": "number" },
        "deletedAt": { "type": "number" }
      },
      "required": ["id", "title", "section"]
    },
    "Setlist": {
      "title": "Setlist",
      "description": "Performance setlist or practice routine",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "items": { "type": "array" },
        "type": { "type": "string" },
        "dateCreated": { "type": "number" },
        "dateModified": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "UserSetting": {
      "title": "UserSetting",
      "description": "User preferences, notes, and category configurations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "categories": { "type": "array" },
        "colors": { "type": "object" },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/songs/{songId}": {
      "schema": { "$ref": "#/entities/Song" },
      "description": "User's collection of songs and charts"
    },
    "/users/{userId}/setlists/{setlistId}": {
      "schema": { "$ref": "#/entities/Setlist" },
      "description": "User's setlists and practice routines"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSetting" },
      "description": "User's notes, custom categories, and app preferences"
    }
  }
}
